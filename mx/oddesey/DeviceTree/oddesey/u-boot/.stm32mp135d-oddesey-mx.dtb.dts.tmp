/ {
 model = "STMicroelectronics custom STM32CubeMX board - openstlinux-6.6-yocto-scarthgap-mpu-v25.06.11";
 compatible = "st,stm32mp135d-oddesey-mx", "st,stm32mp135";

 memory@c0000000 {
  device_type = "memory";
  reg = <0xc0000000 0x20000000>;



 };

 reserved-memory {
  #address-cells = <1>;
  #size-cells = <1>;
  ranges;



  optee@de000000 {
   reg = <0xde000000 0x2000000>;
   no-map;
  };

 };


 aliases {
  serial0 = &uart4;
  ethernet0 = &ethernet1;
  ethernet1 = &ethernet2;
  mmc0 = &sdmmc1;
 };

 chosen {
  stdout-path = "serial0:115200n8";
 };


 vbus_usbh: regulator-vbus-usbh {
  compatible = "regulator-fixed";
  regulator-name = "vbus_usbh";
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;
  gpio = <&gpiog 1 0>;
  enable-active-high;
 };

 leds {
  compatible = "gpio-leds";

  led-1 {
   function = "heartbeat";
   color = <1>;
   gpios = <&gpioh 2 0>;
   linux,default-trigger = "heartbeat";
  };

  led-2 {
   color = <6>;
   gpios = <&gpioc 3 0>;
   linux,default-trigger = "mmc0";
  };

  led-3 {
   color = <3>;
   gpios = <&gpioh 5 0>;
  };
 };

 gpio-keys {
  compatible = "gpio-keys";

  button-user {
   label = "User";
   linux,code = <0x101>;
   gpios = <&gpioa 8 1>;
  };
 };


 clocks{



 };

};

&pinctrl {

 eth1_pins_mx: eth1_mx-0 {
  pins1 {
   pinmux = <(((((('A') - 'A') * 0x10 + (1))) << 8) | (0xc))>,
      <(((((('B') - 'A') * 0x10 + (11))) << 8) | (0xc))>,
      <(((((('G') - 'A') * 0x10 + (2))) << 8) | (0xc))>,
      <(((((('G') - 'A') * 0x10 + (13))) << 8) | (0xc))>,
      <(((((('G') - 'A') * 0x10 + (14))) << 8) | (0xc))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <1>;
  };
  pins2 {
   pinmux = <(((((('A') - 'A') * 0x10 + (2))) << 8) | (0xc))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins3 {
   pinmux = <(((((('C') - 'A') * 0x10 + (1))) << 8) | (0xb))>,
      <(((((('C') - 'A') * 0x10 + (4))) << 8) | (0xc))>,
      <(((((('C') - 'A') * 0x10 + (5))) << 8) | (0xc))>;
   bias-disable;
  };
 };

 eth1_sleep_pins_mx: eth1_sleep_mx-0 {
  pins {
   pinmux = <(((((('A') - 'A') * 0x10 + (1))) << 8) | (0x11))>,
      <(((((('A') - 'A') * 0x10 + (2))) << 8) | (0x11))>,
      <(((((('B') - 'A') * 0x10 + (11))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (1))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (4))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (5))) << 8) | (0x11))>,
      <(((((('G') - 'A') * 0x10 + (2))) << 8) | (0x11))>,
      <(((((('G') - 'A') * 0x10 + (13))) << 8) | (0x11))>,
      <(((((('G') - 'A') * 0x10 + (14))) << 8) | (0x11))>;
  };
 };

 eth2_pins_mx: eth2_mx-0 {
  pins1 {
   pinmux = <(((((('A') - 'A') * 0x10 + (12))) << 8) | (0xc))>,
      <(((((('E') - 'A') * 0x10 + (2))) << 8) | (0xb))>,
      <(((((('F') - 'A') * 0x10 + (4))) << 8) | (0xc))>;
   bias-disable;
  };
  pins2 {
   pinmux = <(((((('B') - 'A') * 0x10 + (2))) << 8) | (0xc))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins3 {
   pinmux = <(((((('F') - 'A') * 0x10 + (6))) << 8) | (0xc))>,
      <(((((('F') - 'A') * 0x10 + (7))) << 8) | (0xc))>,
      <(((((('G') - 'A') * 0x10 + (5))) << 8) | (0xb))>,
      <(((((('G') - 'A') * 0x10 + (8))) << 8) | (0xe))>,
      <(((((('G') - 'A') * 0x10 + (11))) << 8) | (0xb))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <1>;
  };
 };

 eth2_sleep_pins_mx: eth2_sleep_mx-0 {
  pins {
   pinmux = <(((((('A') - 'A') * 0x10 + (12))) << 8) | (0x11))>,
      <(((((('B') - 'A') * 0x10 + (2))) << 8) | (0x11))>,
      <(((((('E') - 'A') * 0x10 + (2))) << 8) | (0x11))>,
      <(((((('F') - 'A') * 0x10 + (4))) << 8) | (0x11))>,
      <(((((('F') - 'A') * 0x10 + (6))) << 8) | (0x11))>,
      <(((((('F') - 'A') * 0x10 + (7))) << 8) | (0x11))>,
      <(((((('G') - 'A') * 0x10 + (5))) << 8) | (0x11))>,
      <(((((('G') - 'A') * 0x10 + (8))) << 8) | (0x11))>,
      <(((((('G') - 'A') * 0x10 + (11))) << 8) | (0x11))>;
  };
 };

 sdmmc1_pins_mx: sdmmc1_mx-0 {
  pins1 {
   pinmux = <(((((('C') - 'A') * 0x10 + (8))) << 8) | (0xd))>,
      <(((((('C') - 'A') * 0x10 + (9))) << 8) | (0xd))>,
      <(((((('C') - 'A') * 0x10 + (10))) << 8) | (0xd))>,
      <(((((('C') - 'A') * 0x10 + (11))) << 8) | (0xd))>,
      <(((((('D') - 'A') * 0x10 + (2))) << 8) | (0xd))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <1>;
  };
  pins2 {
   pinmux = <(((((('C') - 'A') * 0x10 + (12))) << 8) | (0xd))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <3>;
  };
 };

 sdmmc1_opendrain_pins_mx: sdmmc1_opendrain_mx-0 {
  pins1 {
   pinmux = <(((((('C') - 'A') * 0x10 + (8))) << 8) | (0xd))>,
      <(((((('C') - 'A') * 0x10 + (9))) << 8) | (0xd))>,
      <(((((('C') - 'A') * 0x10 + (10))) << 8) | (0xd))>,
      <(((((('C') - 'A') * 0x10 + (11))) << 8) | (0xd))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <1>;
  };
  pins2 {
   pinmux = <(((((('C') - 'A') * 0x10 + (12))) << 8) | (0xd))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <3>;
  };
  pins3 {
   pinmux = <(((((('D') - 'A') * 0x10 + (2))) << 8) | (0xd))>;
   bias-disable;
   drive-open-drain;
   slew-rate = <1>;
  };
 };

 sdmmc1_sleep_pins_mx: sdmmc1_sleep_mx-0 {
  pins {
   pinmux = <(((((('C') - 'A') * 0x10 + (8))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (9))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (10))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (11))) << 8) | (0x11))>,
      <(((((('C') - 'A') * 0x10 + (12))) << 8) | (0x11))>,
      <(((((('D') - 'A') * 0x10 + (2))) << 8) | (0x11))>;
  };
 };

 uart4_pins_mx: uart4_mx-0 {
  pins1 {
   pinmux = <(((((('A') - 'A') * 0x10 + (13))) << 8) | (0x9))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins2 {
   pinmux = <(((((('E') - 'A') * 0x10 + (5))) << 8) | (0x9))>;
   bias-disable;
  };
 };

 uart4_idle_pins_mx: uart4_idle_mx-0 {
  pins1 {
   pinmux = <(((((('A') - 'A') * 0x10 + (13))) << 8) | (0x9))>;
   bias-disable;
   drive-push-pull;
   slew-rate = <0>;
  };
  pins2 {
   pinmux = <(((((('E') - 'A') * 0x10 + (5))) << 8) | (0x9))>;
   bias-disable;
  };
 };

 uart4_sleep_pins_mx: uart4_sleep_mx-0 {
  pins {
   pinmux = <(((((('A') - 'A') * 0x10 + (13))) << 8) | (0x11))>,
      <(((((('E') - 'A') * 0x10 + (5))) << 8) | (0x11))>;
  };
 };



};

&dmamux1 {
 status = "okay";





};

&ethernet1 {
 pinctrl-names = "default", "sleep";
 pinctrl-0 = <&eth1_pins_mx>;
 pinctrl-1 = <&eth1_sleep_pins_mx>;
 status = "okay";


 phy-mode = "rmii";
 max-speed = <100>;
 phy-handle = <&phy0_eth1>;
 nvmem-cells = <&ethernet_mac1_address>;
 nvmem-cell-names = "mac-address";

 mdio {
  #address-cells = <1>;
  #size-cells = <0>;
  compatible = "snps,dwmac-mdio";

  phy0_eth1: ethernet-phy@0 {
   compatible = "ethernet-phy-id0007.c131";
   reg = <0>;
   reset-gpios = <&gpiog 3 1>;
   reset-assert-us = <10000>;
   reset-deassert-us = <80000>;
  };
 };

};

&ethernet2 {
 pinctrl-names = "default", "sleep";
 pinctrl-0 = <&eth2_pins_mx>;
 pinctrl-1 = <&eth2_sleep_pins_mx>;
 status = "okay";


 phy-mode = "rmii";
 max-speed = <100>;
 phy-handle = <&phy0_eth2>;

 st,ext-phyclk;

 phy-supply = <&scmi_v3v3_sw>;
 nvmem-cells = <&ethernet_mac2_address>;
 nvmem-cell-names = "mac-address";

 mdio {
  #address-cells = <1>;
  #size-cells = <0>;
  compatible = "snps,dwmac-mdio";

  phy0_eth2: ethernet-phy@0 {
   compatible = "ethernet-phy-id0007.c131";
   reg = <0>;
   reset-gpios = <&gpioa 11 1>;
   reset-assert-us = <10000>;
   reset-deassert-us = <80000>;
  };
 };

};

&mdma {
 status = "okay";



};

&rcc {
 status = "okay";



};

&rtc {
 status = "okay";



};

&sdmmc1 {
 pinctrl-names = "default", "opendrain", "sleep";
 pinctrl-0 = <&sdmmc1_pins_mx>;
 pinctrl-1 = <&sdmmc1_opendrain_pins_mx>;
 pinctrl-2 = <&sdmmc1_sleep_pins_mx>;
 status = "okay";


 bus-width = <4>;
 st,neg-edge;
 disable-wp;

 cd-gpios = <&gpioh 10 (1 | 16)>;
 vmmc-supply = <&scmi_vdd_sd>;

};

&uart4 {
 pinctrl-names = "default", "idle", "sleep";
 pinctrl-0 = <&uart4_pins_mx>;
 pinctrl-1 = <&uart4_idle_pins_mx>;
 pinctrl-2 = <&uart4_sleep_pins_mx>;
 status = "okay";



};

&usbh_ehci {
 status = "okay";


 phys = <&usbphyc_port0>;

};

&usbh_ohci {
 status = "okay";


 phys = <&usbphyc_port0>;

};

&usbotg_hs {
 status = "okay";



 phys = <&usbphyc_port1 0>;
 phy-names = "usb2-phy";
 dr_mode = "peripheral";


 usb-role-switch;
 role-switch-default-mode = "peripheral";

};

&usbphyc {
 status = "okay";



};

&usbphyc_port0 {
 status = "okay";


 phy-supply = <&scmi_vdd_usb>;

 vbus-supply = <&vbus_usbh>;

};

&usbphyc_port1 {
 status = "okay";


 phy-supply = <&scmi_vdd_usb>;

};


&scmi_regu {
 scmi_vddcpu: regulator@6 {
  reg = <6>;
  regulator-name = "vddcpu";
 };
 scmi_vdd: regulator@8 {
  reg = <8>;
  regulator-name = "vdd";
 };
 scmi_vddcore: regulator@9 {
  reg = <9>;
  regulator-name = "vddcore";
 };
 scmi_vdd_adc: regulator@a {
  reg = <10>;
  regulator-name = "vdd_adc";
 };
 scmi_vdd_usb: regulator@d {
  reg = <13>;
  regulator-name = "vdd_usb";
 };
 scmi_vdd_sd: regulator@e {
  reg = <14>;
  regulator-name = "vdd_sd";
 };
 scmi_v3v3_sw: regulator@13 {
  reg = <19>;
  regulator-name = "v3v3_sw";
 };
};


